# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.cache/

# Miniatyrene MÅ committes: GitHub Actions bygger siden uten Dropbox-tilgang,
# så bildene må ligge i repoet for at den publiserte siden skal vise noe.

# Sikkerhetskopier fra synkroniseringen hører ikke hjemme i repoet.
data/index.backup-*.json

# Varig gh-pages-klone brukt av scripts/deploy.sh
.deploy-gh-pages/
