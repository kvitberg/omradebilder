# Kopier denne filen til .env.local og fyll inn verdiene dine.
# .env.local blir aldri committet til git.

# --- Dropbox ---
# 1. Opprett en app på https://www.dropbox.com/developers/apps ("Scoped access",
#    "App folder" eller "Full Dropbox" avhengig av hvor bildene ligger).
# 2. Under "Permissions" på appen: skru på files.metadata.read og files.content.read.
# 3. Fyll inn App key og App secret her:
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# 4. Kjør: npm run get-dropbox-token
#    Følg instruksjonene i terminalen, og lim inn linjen den gir deg her:
DROPBOX_REFRESH_TOKEN=

# Alternativ for rask testing (utløper etter noen timer, IKKE for produksjon):
# DROPBOX_ACCESS_TOKEN=

# Mappe i Dropbox som skal skannes, f.eks. /Områdebilder. Tomt = hele Dropbox.
DROPBOX_ROOT_FOLDER=

# --- Geokoding ---
# Valgfritt. Uten denne brukes gratis OpenStreetMap Nominatim (fungerer fint,
# men er rate-begrenset). Sett denne for raskere/mer presis geokoding.
GOOGLE_GEOCODING_API_KEY=

# Legges til på slutten av alle geokodings-søk for bedre treff, f.eks. "Norge"
DEFAULT_GEOCODE_REGION=Norge
